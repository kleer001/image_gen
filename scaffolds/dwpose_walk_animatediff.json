{
  "_scaffold": "UNVALIDATED — DWPose -> OpenPose ControlNet -> AnimateDiff (SD1.5) pose-driven walking animation with IPAdapter identity lock. Authored by combining workflows/animatediff_txt2vid.json (AnimateDiff-Evolved) with the ControlNet-apply pattern from workflows/controlnet_pose.json, plus a DWPose preprocessor (comfyui_controlnet_aux) reading a driving walk video (VHS_LoadVideo) and an IPAdapter (ComfyUI_IPAdapter_plus) carrying the character identity. The exact node SCHEMAS have NOT been checked against installed custom nodes — DWPreprocessor's bbox_detector/pose_estimator filenames, VHS_LoadVideo output sockets, IPAdapterUnifiedLoader presets, and per-frame ControlNet batching all drift between releases. See /TODO.md before running. Lives in scaffolds/ (not workflows/) on purpose so the MCP server does not auto-register it until validated. Driver: scripts/pose_walk.py. _meta titles on the two CLIPTextEncode nodes let the driver target positive vs negative.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "v1-5-pruned-emaonly.safetensors"
    }
  },
  "2": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "walk_cycle.mp4",
      "force_rate": 8,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 16,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "3": {
    "class_type": "DWPreprocessor",
    "inputs": {
      "image": ["2", 0],
      "detect_hand": "enable",
      "detect_body": "enable",
      "detect_face": "disable",
      "resolution": 512,
      "bbox_detector": "yolox_l.onnx",
      "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt"
    }
  },
  "4": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "control_v11p_sd15_openpose_fp16.safetensors"
    }
  },
  "5": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": {
      "model": ["1", 0],
      "preset": "PLUS (high strength)"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference.png"
    }
  },
  "7": {
    "class_type": "IPAdapter",
    "inputs": {
      "model": ["5", 0],
      "ipadapter": ["5", 1],
      "image": ["6", 0],
      "weight": 0.8,
      "start_at": 0.0,
      "end_at": 1.0,
      "weight_type": "standard"
    }
  },
  "8": {
    "class_type": "ADE_LoopedUniformContextOptions",
    "inputs": {
      "context_length": 16,
      "context_stride": 1,
      "context_overlap": 4,
      "closed_loop": false,
      "fuse_method": "flat",
      "use_on_equal_length": false,
      "start_percent": 0.0,
      "guarantee_steps": 1
    }
  },
  "9": {
    "class_type": "ADE_AnimateDiffLoaderGen1",
    "inputs": {
      "model": ["7", 0],
      "context_options": ["8", 0],
      "model_name": "mm_sd_v15_v3.safetensors",
      "beta_schedule": "autoselect"
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"},
    "inputs": {
      "clip": ["1", 1],
      "text": "a young woman in a red jacket and jeans, full body, walking, consistent character"
    }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"},
    "inputs": {
      "clip": ["1", 1],
      "text": "ugly, deformed, extra limbs, missing limbs, blurry, watermark, text, low quality, flicker"
    }
  },
  "12": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["10", 0],
      "negative": ["11", 0],
      "control_net": ["4", 0],
      "image": ["3", 0],
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "13": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 768,
      "batch_size": 16
    }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["9", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["13", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["14", 0],
      "vae": ["1", 2]
    }
  },
  "16": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["15", 0],
      "frame_rate": 8,
      "loop_count": 0,
      "filename_prefix": "DWPoseWalk",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}

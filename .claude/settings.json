{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/sync_index.py\" 2>/dev/null || true",
            "statusMessage": "Syncing INDEX.md..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/check_envs_documented.py\" 2>/dev/null || true",
            "statusMessage": "Checking generator environments..."
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /media/menser/fauna/image_gen/scripts/sync_index.py 2>/dev/null || true",
            "statusMessage": "Syncing INDEX.md..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/check_sweep_due.py\" 2>/dev/null || true",
            "statusMessage": "Checking update-sweep cadence..."
          }
        ]
      }
    ]
  }
}

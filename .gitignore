# Tools — anchored to root so they don't match configs/comfyui/ etc.
/comfyui/
/automatic1111/
/comfyui-mcp-server/

# Outputs (content only, dirs kept) — every run directory, not just the two
# named tools, so a new output folder does not have to be added here by hand.
/outputs/*/*
!outputs/*/.gitkeep

# Downloaded upstream model weights. Re-fetchable from the model host, and the
# safetensors here run to 5 GB each, well past what the remote will take.
/models/ideogram-4-nf4-diffusers/

# Python
__pycache__/
*.py[cod]
*.pyo
/comfyui/.venv/
/automatic1111/venv/

# Misc
.DS_Store
*.log
*.tmp
.cache/

# Claude Code session breadcrumbs
BREADCRUMB.md
.claude/scheduled_tasks.lock

# Isolated FLUX.2 ComfyUI (experimental, separate from production comfyui/)
/comfyui_flux2/
# Isolated ComfyUI v0.26.x instance (Krea 2 / Bernini-R / Depth Anything 3)
/comfyui_v26/

# Isolated MiniMax H3 ComfyUI (v0.35.0, cu130)
/comfyui_h3/
ideogram4_env/

# Scratch (session staging: logs, probes, extracted frames)
/tmp/

# Playwright MCP scratch (snapshots, console logs, screenshots)
/.playwright-mcp/

# Reference images, plates and personal shot lists. The stack is the tracked
# part; the imagery fed into it is the operator's own and stays local — third
# party photos carry licence and likeness terms that a public repo cannot
# propagate. Directories are kept so example paths still resolve.
/refs/*
!refs/.gitkeep
/refs/h3/*
!refs/h3/.gitkeep
/plates/*
!plates/.gitkeep

# Working shot lists at repo root. The reader-facing copies live in examples/.
/shots.yaml
/vace_shots.yaml
/char_sheet_fresh.yaml
/char_sheet_kontext.yaml

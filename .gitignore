# Tools — anchored to root so they don't match configs/comfyui/ etc.
/comfyui/
/automatic1111/
/comfyui-mcp-server/

# Outputs (content only, dirs kept) — every run directory, not just the two
# named tools, so a new output folder does not have to be added here by hand.
/outputs/*/*
!outputs/*/.gitkeep

# Downloaded upstream model weights. Re-fetchable from the model host, and the
# safetensors here run to 5 GB each, well past what the remote will take.
/models/ideogram-4-nf4-diffusers/

# Python
__pycache__/
*.py[cod]
*.pyo
/comfyui/.venv/
/automatic1111/venv/

# Misc
.DS_Store
*.log
*.tmp
.cache/

# Claude Code session breadcrumbs
BREADCRUMB.md
.claude/scheduled_tasks.lock

# Isolated FLUX.2 ComfyUI (experimental, separate from production comfyui/)
/comfyui_flux2/
# Isolated ComfyUI v0.26.x instance (Krea 2 / Bernini-R / Depth Anything 3)
/comfyui_v26/

# Isolated MiniMax H3 ComfyUI (v0.35.0, cu130)
/comfyui_h3/
ideogram4_env/

# Scratch (session staging: logs, probes, extracted frames)
/tmp/

# Playwright MCP scratch (snapshots, console logs, screenshots)
/.playwright-mcp/

# Personal reference photo — kept out of git history on purpose.
# The CC-licensed Wikimedia references in refs/h3/ are tracked.
/refs/h3/menser.jpg
